@inherits LayoutComponentBase
@implements IDisposable
@inject Sessao Sessao
@inject Tema Tema
@inject NavigationManager Nav
@inject Avisos Avisos

@if (!Sessao.EhGestor)
{
    @* Sem perfil de gestão (o conteúdo aqui é o aviso de acesso restrito): mostra o site público em volta. *@
    <BarraSuperior />
    <main>@Body</main>
    <Rodape />
    <ListaAvisos />
    return;
}
<div class="g-shell">
    <aside class="g-side">
        <a href="gestao" class="brand" aria-label="Conexão Solidária, gestão"><Logo Tamanho="30" /></a>
        <span class="g-org">ONG Esperança Solidária · Gestão</span>
        <nav class="g-nav" aria-label="Gestão">
            <NavLink href="gestao" Match="NavLinkMatch.All" ActiveClass="on"><Icone Nome="home" /><span class="t">Visão geral</span><span class="c">Início</span></NavLink>
            <NavLink href="gestao/campanhas" ActiveClass="on"><Icone Nome="flag" /><span class="t">Campanhas</span><span class="c">Campanhas</span></NavLink>
            <NavLink href="gestao/doadores" ActiveClass="on"><Icone Nome="users" /><span class="t">Doadores</span><span class="c">Doadores</span></NavLink>
            <NavLink href="gestao/doacoes" ActiveClass="on"><Icone Nome="heart" /><span class="t">Doações</span><span class="c">Doações</span></NavLink>
            <hr />
            <a href=""><Icone Nome="globe" /><span class="t">Painel público</span><span class="c">Site</span></a>
            <button class="g-theme" @onclick="Tema.AlternarAsync" aria-pressed="@(Tema.Escuro ? "true" : "false")">
                <Icone Nome="@(Tema.Escuro ? "sun" : "moon")" />@(Tema.Escuro ? "Tema claro" : "Tema escuro")
            </button>
        </nav>
        <div class="g-user">
            <Avatar Nome="@(Sessao.Nome ?? "")" />
            <div class="grow"><b>@Sessao.Nome</b><small>Equipe da ONG</small></div>
            <BotaoTema />
            <button class="btn-icon" @onclick="SairAsync" aria-label="Sair" title="Sair"><Icone Nome="logout" Tamanho="17" /></button>
        </div>
    </aside>
    <main class="g-main"><div class="g-inner">@Body</div></main>
</div>
<ListaAvisos />

@code {
    protected override void OnInitialized() => Tema.Mudou += Atualizar;
    private void Atualizar() => InvokeAsync(StateHasChanged);

    private async Task SairAsync()
    {
        await Sessao.SairAsync();
        Avisos.Info("Você saiu da sua conta.");
        Nav.NavigateTo("");
    }

    public void Dispose() => Tema.Mudou -= Atualizar;
}
