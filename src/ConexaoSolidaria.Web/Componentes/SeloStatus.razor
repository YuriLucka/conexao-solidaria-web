@* Selo do status da campanha. *@
@switch (Status)
{
    case StatusCampanha.Concluida:
        <span class="pill pill-info"><Icone Nome="check" Tamanho="13" />Concluída</span>
        break;
    case StatusCampanha.Cancelada:
        <span class="pill pill-bad"><Icone Nome="x" Tamanho="13" />Cancelada</span>
        break;
    case StatusCampanha.Ativa when PrazoEncerrado:
        <span class="pill pill-warn"><Icone Nome="clock" Tamanho="13" />Prazo encerrado</span>
        break;
    default:
        <span class="pill pill-ok"><span class="dot"></span>Ativa</span>
        break;
}

@code {
    [Parameter, EditorRequired] public StatusCampanha Status { get; set; } = StatusCampanha.Ativa;
    [Parameter] public bool PrazoEncerrado { get; set; }
}
