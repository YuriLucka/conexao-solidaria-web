@* Card de campanha do painel (e prévia no formulário da gestão, sem links). *@
<article class="camp-card">
    <a href="@Link" class="camp-cover" tabindex="-1" aria-hidden="true">
        <Capa Escolhida="@CapaId" Categoria="@Categoria" />
        @if (!string.IsNullOrEmpty(Categoria))
        {
            <span class="cat-tag">@Categoria</span>
        }
    </a>
    <div class="camp-body">
        <h3><a href="@Link">@(string.IsNullOrWhiteSpace(Titulo) ? "Título da campanha" : Titulo)</a></h3>
        <p class="camp-desc">@(string.IsNullOrWhiteSpace(Descricao) ? "A descrição aparece aqui." : Descricao)</p>
        <Medidor Progresso="@Progresso" Encerrado="@(PrazoEncerrado || Status != StatusCampanha.Ativa)" Rotulo="@($"{Formatos.Porcentagem(Progresso)} da meta")" />
        <div class="camp-nums">
            <div><strong class="tnum valor-arrecadado">@Formatos.DinheiroInteiro(Arrecadado)</strong><span>de @Formatos.DinheiroInteiro(Meta)</span></div>
            @if (Progresso >= 1)
            {
                <span class="pill pill-sol" title="@Formatos.Porcentagem(Progresso) da meta"><Icone Nome="check" Tamanho="13" />Meta batida</span>
            }
            else
            {
                <div class="pct">@Formatos.Porcentagem(Progresso)</div>
            }
        </div>
        <div class="camp-foot">
            <span class="small @(Urgente ? "prazo-urgente" : "muted")"><Icone Nome="clock" Tamanho="14" /> @Formatos.Prazo(Status, DataFim, PrazoEncerrado)</span>
            @if (Status == StatusCampanha.Ativa && !PrazoEncerrado)
            {
                <a class="btn btn-doar btn-sm" href="@Link">Doar</a>
            }
            else
            {
                <SeloStatus Status="@Status" PrazoEncerrado="PrazoEncerrado" />
            }
        </div>
    </div>
</article>

@code {
    // Faltando 3 dias ou menos: prazo em destaque (coral) para quem ainda quer ajudar.
    private bool Urgente => Status == StatusCampanha.Ativa && !PrazoEncerrado && Formatos.DiasRestantes(DataFim) <= 3;

    [Parameter] public Guid? Id { get; set; }
    [Parameter] public string Titulo { get; set; } = "";
    [Parameter] public string Descricao { get; set; } = "";
    [Parameter] public decimal Meta { get; set; }
    [Parameter] public decimal Arrecadado { get; set; }
    [Parameter] public DateTime DataFim { get; set; }
    [Parameter] public bool PrazoEncerrado { get; set; }
    [Parameter] public StatusCampanha Status { get; set; } = StatusCampanha.Ativa;
    [Parameter] public string? Categoria { get; set; }
    [Parameter] public string? CapaId { get; set; }

    private string? Link => Id is null ? null : $"campanhas/{Id}";
    private double Progresso => Formatos.Progresso(Arrecadado, Meta);
}
