@inject Sessao Sessao
@inject Tema Tema

<MudThemeProvider Theme="TemaMud.Marca" IsDarkMode="Tema.Escuro" />
<MudPopoverProvider />
<MudDialogProvider />

@if (_pronto)
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NaoEncontrada)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(PublicoLayout)">
                <NotAuthorized>
                    @if (!Sessao.Logado)
                    {
                        <IrParaLogin />
                    }
                    else
                    {
                        <AcessoRestrito />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="wrap"><Carregando /></div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    private bool _pronto;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(Sessao.CarregarAsync(), Tema.CarregarAsync());
        Tema.Mudou += () => InvokeAsync(StateHasChanged);
        _pronto = true;
    }
}
