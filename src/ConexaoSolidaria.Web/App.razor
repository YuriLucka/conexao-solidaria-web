@inject Sessao Sessao
@inject Tema Tema
@inject IJSRuntime Js

<MudThemeProvider Theme="TemaMud.Marca" IsDarkMode="Tema.Escuro" />
<MudPopoverProvider />
<MudDialogProvider />

@if (_pronto)
{
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NaoEncontrada)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(PublicoLayout)">
                <NotAuthorized>
                    @if (!Sessao.Logado)
                    {
                        <IrParaLogin />
                    }
                    else
                    {
                        <AcessoRestrito />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="wrap"><Carregando /></div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
}

@code {
    private bool _pronto;
    private bool _aberturaFechada;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(Sessao.CarregarAsync(), Tema.CarregarAsync());
        Tema.Mudou += () => InvokeAsync(StateHasChanged);
        _pronto = true;
    }

    // A abertura só sai quando a primeira tela já está desenhada: sem piscar em branco enquanto a sessão é restaurada.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pronto && !_aberturaFechada)
        {
            _aberturaFechada = true;
            try { await Js.InvokeVoidAsync("cs.fecharAbertura"); }
            catch (JSException) { }
        }
    }
}
