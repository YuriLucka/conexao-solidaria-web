@page "/minhas-doacoes"
@attribute [Authorize(Roles = "Doador")]
@implements IAsyncDisposable
@inject Api Api

<PageTitle>Minhas doações · Conexão Solidária</PageTitle>

<div class="wrap section">
    <span class="eyebrow">Minha conta</span>
    <h1 style="margin:8px 0 22px">Minhas doações</h1>
    @if (_erro is not null)
    {
        <Estado Expressao="preocupado" Titulo="Não conseguimos carregar suas doações" Texto="@_erro">
            <button class="btn btn-primary" @onclick="CarregarAsync">Tentar de novo</button>
        </Estado>
    }
    else if (_doacoes is null)
    {
        <Carregando Texto="Buscando suas doações" />
    }
    else
    {
        var resumo = _doacoes.Resumo;
        <div class="tiles" style="margin-bottom:22px">
            <div class="tile hero"><span class="lbl">Total doado</span><span class="val tnum">@Formatos.Dinheiro(resumo.TotalDoado)</span></div>
            <div class="tile"><span class="lbl">Doações</span><span class="val">@Formatos.Numero(resumo.Confirmadas)</span></div>
            <div class="tile"><span class="lbl">Campanhas apoiadas</span><span class="val">@Formatos.Numero(resumo.CampanhasApoiadas)</span></div>
            <div class="tile"><span class="lbl">Em confirmação</span><span class="val">@Formatos.Numero(resumo.Pendentes)</span></div>
        </div>

        @if (resumo.Confirmadas > 0)
        {
            var apoiadas = resumo.CampanhasApoiadas;
            <section class="card meu-impacto">
                <div class="mi-head">
                    <Sol Expressao="radiante" Tamanho="84" />
                    <div><span class="eyebrow">Seu impacto até aqui</span><h2>Você já apoiou @Formatos.Numero(apoiadas) @(apoiadas > 1 ? "campanhas" : "campanha"). Cada doação contribui para o cuidado de 220 crianças.</h2></div>
                </div>
                <ul class="mi-list">
                    @foreach (var x in resumo.PorCampanha)
                    {
                        <li>
                            <span class="capa-mini"><Capa Escolhida="@x.Capa" Categoria="@x.Categoria" /></span>
                            <div class="corta"><b>@Formatos.Dinheiro(x.Valor)</b><small><a href="campanhas/@x.IdCampanha" title="@x.TituloCampanha">@x.TituloCampanha</a></small></div>
                        </li>
                    }
                </ul>
                @if (apoiadas > resumo.PorCampanha.Count)
                {
                    <p class="muted small mi-mais">E mais @Formatos.Numero(apoiadas - resumo.PorCampanha.Count) @(apoiadas - resumo.PorCampanha.Count == 1 ? "campanha" : "campanhas") no histórico abaixo.</p>
                }
            </section>
        }

        @if (_doacoes.Total > 0)
        {
            <h2 style="margin:26px 0 12px;font-size:20px">Histórico</h2>
            <div class="card t-card">
                <div class="tscroll">
                    <table class="table rtable" style="min-width:620px">
                        <thead><tr><th>Data</th><th>Campanha</th><th class="num">Valor</th><th>Situação</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var d in _doacoes.Itens)
                            {
                                <tr>
                                    <td class="tnum" data-label="Data">@Formatos.DataHora(d.CriadaEm)</td>
                                    <td class="full first"><a class="corta-2" href="campanhas/@d.IdCampanha" title="@d.TituloCampanha">@d.TituloCampanha</a></td>
                                    <td class="num end" data-label="Valor">@Formatos.Dinheiro(d.ValorDoacao)</td>
                                    <td><SeloDoacao Status="@d.Status" /></td>
                                    <td class="num end"><a href="doacoes/@d.Id" class="small">Detalhes</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Paginador Pagina="_pagina" Total="_doacoes.Total" Tamanho="PorPagina" AoMudar="IrParaAsync" />
            </div>
        }
        else
        {
            <div class="card">
                <Estado Expressao="espiando" Titulo="Nenhuma doação por aqui ainda" Texto="Escolha uma campanha e faça a sua primeira doação." Tamanho="140">
                    <a class="btn btn-doar" href="">Ver campanhas</a>
                </Estado>
            </div>
        }
    }
</div>

@code {
    private const int PorPagina = 15;
    private MinhasDoacoesPagina? _doacoes;
    private int _pagina = 1;
    private string? _erro;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
        _ = AtualizarPendentesAsync();
    }

    private async Task CarregarAsync()
    {
        var r = await Api.MinhasDoacoesAsync(_pagina, PorPagina);
        if (!r.Ok) { if (_doacoes is null) _erro = r.Problema!.Mensagem; return; }
        _erro = null;
        _doacoes = r.Valor;
    }

    private async Task IrParaAsync(int pagina)
    {
        _pagina = pagina;
        await CarregarAsync();
    }

    // Doações em confirmação mudam sozinhas para Confirmada.
    private async Task AtualizarPendentesAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (_doacoes is not { Resumo.Pendentes: > 0 }) continue;
                await CarregarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        return ValueTask.CompletedTask;
    }
}
