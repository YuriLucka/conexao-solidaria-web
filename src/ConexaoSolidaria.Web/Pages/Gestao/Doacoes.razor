@page "/gestao/doacoes"
@layout GestaoLayout
@attribute [Authorize(Roles = "GestorONG")]
@implements IAsyncDisposable
@inject Api Api

<PageTitle>Doações · Gestão · Conexão Solidária</PageTitle>

<div class="g-head">
    <div><span class="eyebrow">Gestão</span><h1>Doações</h1><p>Todas as doações recebidas, da mais recente para a mais antiga.</p></div>
</div>

@if (_erro is not null)
{
    <Estado Expressao="preocupado" Titulo="Não conseguimos carregar as doações" Texto="@_erro">
        <button class="btn btn-primary" @onclick="CarregarAsync">Tentar de novo</button>
    </Estado>
}
else if (_todas is null)
{
    <Carregando Texto="Buscando as doações" />
}
else
{
    var daCampanha = _todas.Where(d => _campanha == "" || d.IdCampanha.ToString() == _campanha).ToList();
    var lista = daCampanha.Where(d => _situacao == "Todas" || d.Status == _situacao)
        .Where(d => _busca.Trim() is "" || d.NomeDoador.Contains(_busca.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    var confirmadas = lista.Where(d => d.Status == "Processada").ToList();
    var paginas = Math.Max(1, (int)Math.Ceiling(lista.Count / (double)PorPagina));
    var pagina = Math.Min(_pagina, paginas);
    <div class="tiles">
        <div class="tile hero"><span class="lbl">Total confirmado</span><span class="val">@Formatos.DinheiroInteiro(confirmadas.Sum(d => d.ValorDoacao))</span><span class="small muted">com os filtros atuais</span></div>
        <div class="tile"><span class="lbl">Doações</span><span class="val">@Formatos.Numero(lista.Count)</span></div>
        <div class="tile"><span class="lbl">Ticket médio</span><span class="val">@Formatos.Dinheiro(confirmadas.Count == 0 ? 0 : confirmadas.Average(d => d.ValorDoacao))</span></div>
        <div class="tile"><span class="lbl">Em confirmação agora</span><span class="val">@daCampanha.Count(d => d.Status == "Pendente")</span></div>
    </div>
    <div class="toolbar">
        <div class="search"><Icone Nome="search" Tamanho="17" /><input type="search" placeholder="Buscar por doador" aria-label="Buscar doações" @bind="_busca" @bind:event="oninput" @bind:after="() => _pagina = 1" /></div>
        <select aria-label="Filtrar por campanha" style="width:auto;max-width:100%;border-radius:999px" @bind="_campanha" @bind:after="() => _pagina = 1">
            <option value="">Todas as campanhas</option>
            @foreach (var c in _todas.GroupBy(d => d.IdCampanha).Select(g => (g.Key, g.First().TituloCampanha)).OrderBy(x => x.Item2))
            {
                <option value="@c.Key">@c.Item2</option>
            }
        </select>
        <div class="chips" role="group" aria-label="Filtrar por situação">
            @foreach (var (s, rotulo) in Situacoes)
            {
                <button class="chip @(_situacao == s ? "on" : "")" aria-pressed="@(_situacao == s ? "true" : "false")" @onclick="() => { _situacao = s; _pagina = 1; }">@rotulo <span>@Formatos.Numero(daCampanha.Count(d => s == "Todas" || d.Status == s))</span></button>
            }
        </div>
    </div>
    <div class="card t-card">
        <div class="tscroll">
            <table class="table rtable" style="min-width:820px">
                <thead><tr><th>Data</th><th>Doador</th><th>Campanha</th><th class="num">Valor</th><th>Situação</th></tr></thead>
                <tbody>
                    @foreach (var d in lista.Skip((pagina - 1) * PorPagina).Take(PorPagina))
                    {
                        <tr>
                            <td class="tnum small" data-label="Data">@Formatos.DataHora(d.CriadaEm)</td>
                            <td class="full first"><div class="person"><Avatar Nome="@d.NomeDoador" /><div><b>@d.NomeDoador</b></div></div></td>
                            <td class="full o1"><a href="gestao/campanhas/@d.IdCampanha">@d.TituloCampanha</a></td>
                            <td class="num end" data-label="Valor">@Formatos.Dinheiro(d.ValorDoacao)</td>
                            <td><SeloDoacao Status="@d.Status" /></td>
                        </tr>
                    }
                    @if (lista.Count == 0)
                    {
                        <tr><td colspan="5" class="empty-cell full"><Estado Expressao="espiando" Titulo="Nenhuma doação encontrada" Texto="Tente outro filtro." Tamanho="100" Classe="state-sm" /></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="pager">
            <span>Página @pagina de @paginas</span>
            <div class="row">
                <button class="btn btn-ghost btn-sm" disabled="@(pagina <= 1)" @onclick="() => _pagina = pagina - 1"><Icone Nome="left" Tamanho="15" />Anterior</button>
                <button class="btn btn-ghost btn-sm" disabled="@(pagina >= paginas)" @onclick="() => _pagina = pagina + 1">Próxima<Icone Nome="right" Tamanho="15" /></button>
            </div>
        </div>
    </div>
}

@code {
    private const int PorPagina = 20;
    private static readonly (string, string)[] Situacoes = [("Todas", "Todas"), ("Processada", "Confirmadas"), ("Pendente", "Em confirmação"), ("Rejeitada", "Não concluídas")];
    private List<DoacaoGestao>? _todas;
    private string _busca = "", _campanha = "", _situacao = "Todas";
    private int _pagina = 1;
    private string? _erro;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
        _ = AoVivoAsync();
    }

    private async Task CarregarAsync()
    {
        var r = await Api.DoacoesGestaoAsync(limite: 500);
        if (r.Ok) (_todas, _erro) = (r.Valor, null);
        else if (_todas is null) _erro = r.Problema!.Mensagem;
    }

    private async Task AoVivoAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await CarregarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        return ValueTask.CompletedTask;
    }
}
