@page "/gestao/campanhas/{Id:guid}"
@layout GestaoLayout
@attribute [Authorize(Roles = Perfis.GestorONG)]
@implements IAsyncDisposable
@inject Api Api
@inject Avisos Avisos

<PageTitle>@(_campanha?.Titulo ?? "Campanha") · Gestão · Conexão Solidária</PageTitle>

@if (_naoEncontrada)
{
    <Estado Expressao="curioso" Titulo="Não encontramos essa campanha" Texto="Ela pode ter sido removida ou o endereço pode estar errado.">
        <a class="btn btn-primary" href="gestao/campanhas">Ver campanhas</a>
    </Estado>
}
else if (_campanha is null)
{
    <Carregando Texto="Buscando a campanha" />
}
else
{
    var c = _campanha;
    var p = Formatos.Progresso(c.ValorTotalArrecadado, c.MetaFinanceira);
    var t = _doacoes?.Totais;
    var naoConfirmadas = (t?.Pendentes ?? 0) + (t?.Rejeitadas ?? 0);
    <a href="gestao/campanhas" class="back" style="margin:0"><Icone Nome="left" Tamanho="16" />Campanhas</a>
    <div class="g-head">
        <div>
            <div class="row"><SeloStatus Status="@c.Status" PrazoEncerrado="c.PrazoEncerrado" /><span class="muted small">@c.Categoria</span></div>
            <h1 class="titulo-longo">@c.Titulo</h1>
            <p>@Formatos.DataHora(c.DataInicio) até @Formatos.DataHora(c.DataFim) · @Formatos.Prazo(c.Status, c.DataFim, c.PrazoEncerrado)</p>
        </div>
        <div class="g-actions">
            <a class="btn btn-ghost" href="campanhas/@c.Id"><Icone Nome="globe" Tamanho="16" />Ver no painel público</a>
            <a class="btn btn-ghost" href="gestao/campanhas/@c.Id/editar"><Icone Nome="edit" Tamanho="16" />Editar</a>
            @if (c.Status == StatusCampanha.Ativa)
            {
                <button class="btn btn-quiet" @onclick="@(() => Perguntar(StatusCampanha.Concluida))"><Icone Nome="check" Tamanho="16" />Concluir</button>
                <button class="btn btn-quiet btn-perigo" @onclick="@(() => Perguntar(StatusCampanha.Cancelada))"><Icone Nome="x" Tamanho="16" />Cancelar campanha</button>
            }
        </div>
    </div>
    <div class="tiles">
        <div class="tile hero"><span class="lbl"><span class="tile-ic ic-verde"><Icone Nome="moeda" Tamanho="16" /></span>Arrecadado</span><span class="val">@Formatos.DinheiroInteiro(c.ValorTotalArrecadado)</span><span class="small muted">de @Formatos.DinheiroInteiro(c.MetaFinanceira) · @Formatos.Porcentagem(p)</span><Medidor Progresso="p" Classe="thin" /></div>
        <div class="tile"><span class="lbl"><span class="tile-ic ic-coral"><Icone Nome="heart" Tamanho="16" /></span>Doações confirmadas</span><span class="val">@Formatos.Numero(t?.Confirmadas ?? 0)</span><span class="small muted">@Formatos.Numero(naoConfirmadas) em confirmação ou não @(naoConfirmadas == 1 ? "concluída" : "concluídas")</span></div>
        <div class="tile"><span class="lbl"><span class="tile-ic ic-info"><Icone Nome="users" Tamanho="16" /></span>Doadores únicos</span><span class="val">@Formatos.Numero(t?.DoadoresUnicos ?? 0)</span></div>
        <div class="tile"><span class="lbl"><span class="tile-ic ic-sol"><Icone Nome="recibo" Tamanho="16" /></span>Ticket médio</span><span class="val">@((t?.Confirmadas ?? 0) == 0 ? "—" : Formatos.Dinheiro(t!.TicketMedio))</span></div>
    </div>
    <section class="card t-card">
        <div class="card-head"><h2>Doações</h2><span class="muted small">@Formatos.Numero(_doacoes?.Total ?? 0) no total</span></div>
        <div class="tscroll">
            <table class="table rtable" style="min-width:680px">
                <thead><tr><th>Doador</th><th>Data</th><th class="num">Valor</th><th>Situação</th></tr></thead>
                <tbody>
                    @foreach (var d in _doacoes?.Itens ?? [])
                    {
                        <tr>
                            <td class="full first"><div class="person"><Avatar Nome="@d.NomeDoador" /><div class="corta"><b title="@d.NomeDoador">@d.NomeDoador</b></div></div></td>
                            <td class="tnum small" data-label="Data">@Formatos.DataHora(d.CriadaEm)</td>
                            <td class="num end" data-label="Valor">@Formatos.Dinheiro(d.ValorDoacao)</td>
                            <td><SeloDoacao Status="@d.Status" /></td>
                        </tr>
                    }
                    @if (_doacoes is { Total: 0 })
                    {
                        <tr><td colspan="4" class="empty-cell full"><Estado Expressao="espiando" Titulo="Nenhuma doação ainda" Tamanho="100" Classe="state-sm" /></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginador Pagina="_pagina" Total="_doacoes?.Total ?? 0" Tamanho="PorPagina" AoMudar="IrParaAsync" />
    </section>
    <Confirmacao Aberta="@(_pergunta is not null)" Ocupado="_salvando"
                 Titulo="@(_pergunta == StatusCampanha.Concluida ? "Concluir esta campanha?" : "Cancelar esta campanha?")"
                 Texto="@(_pergunta == StatusCampanha.Concluida ? "Ela sai do painel público e para de receber doações. O valor arrecadado fica registrado. É possível reabri-la depois, se a data de término ainda não tiver passado." : "Ela sai do painel público e para de receber doações. Doações ainda em confirmação não serão somadas.")"
                 Ok="@(_pergunta == StatusCampanha.Concluida ? "Concluir" : "Cancelar campanha")" Perigo="@(_pergunta == StatusCampanha.Cancelada)"
                 AoConfirmar="MudarStatusAsync" AoVoltar="() => _pergunta = null" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Campanha? _campanha;
    private const int PorPagina = 15;
    private DoacoesGestaoPagina? _doacoes;
    private int _pagina = 1;
    private bool _naoEncontrada, _salvando;
    private StatusCampanha? _pergunta;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
        _ = AoVivoAsync();
    }

    private async Task CarregarAsync()
    {
        var c = Api.CampanhaAsync(Id);
        var d = Api.DoacoesGestaoAsync(Id, pagina: _pagina, tamanho: PorPagina);
        var rc = await c;
        if (!rc.Ok) { _naoEncontrada = rc.Problema!.Status == 404; return; }
        _campanha = rc.Valor;
        var rd = await d;
        if (rd.Ok) _doacoes = rd.Valor;
    }

    private async Task IrParaAsync(int pagina)
    {
        _pagina = pagina;
        await CarregarAsync();
    }

    private void Perguntar(StatusCampanha status) => _pergunta = status;

    // Concluir/cancelar = PUT com os mesmos dados e o novo status.
    private async Task MudarStatusAsync()
    {
        var c = _campanha!;
        var novo = _pergunta;
        _salvando = true;
        var r = await Api.AtualizarCampanhaAsync(c.Id, new SalvarCampanhaRequest(c.Titulo, c.Descricao, c.DataInicio, c.DataFim,
            c.MetaFinanceira, novo, c.Categoria, c.Capa, c.CriancasAtendidas));
        _salvando = false;
        if (r.Ok)
        {
            Avisos.Ok(novo == StatusCampanha.Concluida ? "Campanha concluída." : "Campanha cancelada.");
            _campanha = r.Valor;
        }
        else Avisos.Erro(r.Problema!.Mensagem);
        _pergunta = null;
    }

    private async Task AoVivoAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                if (_pergunta is not null) continue;
                await CarregarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        return ValueTask.CompletedTask;
    }
}
