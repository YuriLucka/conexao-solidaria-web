@page "/gestao/doadores"
@layout GestaoLayout
@attribute [Authorize(Roles = Perfis.GestorONG)]
@implements IDisposable
@inject Api Api

<PageTitle>Doadores · Gestão · Conexão Solidária</PageTitle>

<div class="g-head">
    <div><span class="eyebrow">Gestão</span><h1>Doadores</h1><p>Pessoas cadastradas para doar. Por privacidade, o CPF aparece parcialmente oculto.</p></div>
</div>

@if (_erro is not null && _dados is null)
{
    <Estado Expressao="preocupado" Titulo="Não conseguimos carregar os doadores" Texto="@_erro">
        <button class="btn btn-primary" @onclick="CarregarAsync">Tentar de novo</button>
    </Estado>
}
else if (_dados is null)
{
    <Carregando Texto="Buscando os doadores" />
}
else
{
    var ind = _dados.Indicadores;
    <div class="tiles">
        <div class="tile"><span class="lbl"><span class="tile-ic ic-info"><Icone Nome="users" Tamanho="16" /></span>Doadores cadastrados</span><span class="val">@Formatos.Numero(ind.Cadastrados)</span></div>
        <div class="tile"><span class="lbl"><span class="tile-ic ic-coral"><Icone Nome="heart" Tamanho="16" /></span>Doaram nos últimos 30 dias</span><span class="val">@Formatos.Numero(ind.DoaramUltimos30Dias)</span></div>
        <div class="tile"><span class="lbl"><span class="tile-ic ic-verde"><Icone Nome="refresh" Tamanho="16" /></span>Recorrentes (2 ou mais doações)</span><span class="val">@Formatos.Numero(ind.Recorrentes)</span></div>
        <div class="tile"><span class="lbl"><span class="tile-ic ic-sol"><Icone Nome="plus" Tamanho="16" /></span>Novos nos últimos 30 dias</span><span class="val">@Formatos.Numero(ind.NovosUltimos30Dias)</span></div>
    </div>
    <div class="toolbar">
        <div class="search"><Icone Nome="search" Tamanho="17" /><input type="search" placeholder="Buscar por nome ou e-mail" aria-label="Buscar doadores" @bind="_busca" @bind:event="oninput" @bind:after="BuscarAsync" /></div>
        <span class="muted small">@Formatos.Numero(_dados.Total) @(_dados.Total == 1 ? "resultado" : "resultados")</span>
    </div>
    <div class="card t-card">
        <div class="tscroll">
            <table class="table rtable" style="min-width:820px">
                <thead><tr><th>Doador</th><th>CPF</th><th>Cadastro</th><th class="num">Doações</th><th class="num">Total doado</th><th>Última doação</th></tr></thead>
                <tbody>
                    @foreach (var d in _dados.Itens)
                    {
                        <tr>
                            <td class="full first"><div class="person"><Avatar Nome="@d.NomeCompleto" /><div class="corta"><b title="@d.NomeCompleto">@d.NomeCompleto</b><small title="@d.Email">@d.Email</small></div></div></td>
                            <td class="tnum small" data-label="CPF">@d.CpfMascarado</td>
                            <td class="tnum small end" data-label="Cadastro">@Formatos.Data(d.CriadoEm)</td>
                            <td class="num" data-label="Doações">@Formatos.Numero(d.QuantidadeDoacoes)</td>
                            <td class="num end" data-label="Total doado"><b>@Formatos.Dinheiro(d.TotalDoado)</b></td>
                            <td class="small muted" data-label="Última doação">@(d.UltimaDoacaoEm is DateTime u ? Formatos.Ha(u) : "—")</td>
                        </tr>
                    }
                    @if (_dados.Itens.Count == 0)
                    {
                        <tr><td colspan="6" class="empty-cell full"><Estado Expressao="espiando" Titulo="@(ind.Cadastrados == 0 ? "Nenhum doador cadastrado ainda" : "Nenhum doador encontrado")" Texto="@(ind.Cadastrados == 0 ? "Os doadores aparecem aqui assim que criarem a conta no site." : "Tente outra busca.")" Tamanho="100" Classe="state-sm" /></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <Paginador Pagina="_dados.Pagina" Total="_dados.Total" Tamanho="PorPagina" Ocupado="_carregando" AoMudar="IrParaAsync" />
    </div>
}

@code {
    private const int PorPagina = 15;
    private DoadoresGestaoPagina? _dados;
    private string _busca = "";
    private int _pagina = 1;
    private bool _carregando;
    private string? _erro;
    private CancellationTokenSource? _digitacao;

    protected override Task OnInitializedAsync() => CarregarAsync();

    private async Task CarregarAsync()
    {
        _carregando = true;
        var r = await Api.DoadoresAsync(_busca, _pagina, PorPagina);
        _carregando = false;
        if (r.Ok) (_dados, _erro) = (r.Valor, null);
        else _erro = r.Problema!.Mensagem;
    }

    private async Task IrParaAsync(int pagina)
    {
        _pagina = pagina;
        await CarregarAsync();
    }

    // Espera a pessoa parar de digitar (300 ms) antes de buscar no servidor.
    private async Task BuscarAsync()
    {
        _digitacao?.Cancel();
        _digitacao = new CancellationTokenSource();
        try { await Task.Delay(300, _digitacao.Token); }
        catch (TaskCanceledException) { return; }
        await IrParaAsync(1);
    }

    public void Dispose() => _digitacao?.Cancel();
}
