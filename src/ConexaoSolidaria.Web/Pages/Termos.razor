@page "/termos"

<PageTitle>Termos de uso e privacidade · Conexão Solidária</PageTitle>

<div class="wrap section" style="max-width:800px">
    <span class="eyebrow">Institucional</span>
    <h1 style="margin:8px 0 22px">Termos de uso e privacidade</h1>
    <div class="card legal">
        @foreach (var (titulo, texto) in Secoes)
        {
            <div><h2>@titulo</h2><p>@texto</p></div>
        }
    </div>
</div>

@code {
    private static readonly (string, string)[] Secoes =
    [
        ("Sobre a plataforma", "A Conexão Solidária é mantida pela ONG Esperança Solidária para receber doações e mostrar, com transparência, quanto cada campanha arrecadou."),
        ("Doações", "Cada doação vai para a campanha escolhida. Se a campanha terminar antes da confirmação, a doação não é concluída e nenhum valor é somado."),
        ("Dados que coletamos", "Nome completo, e-mail, CPF e senha. Usamos esses dados apenas para dar acesso à sua conta e identificar as suas doações."),
        ("Compartilhamento", "Não vendemos nem compartilhamos seus dados com terceiros. Eles são usados somente pela ONG Esperança Solidária, para as finalidades descritas aqui."),
        ("Armazenamento no navegador", "O site guarda no seu navegador apenas a sessão de acesso e a preferência de tema (claro ou escuro). Ao sair da conta, a sessão é apagada."),
        ("Por quanto tempo guardamos", "Mantemos seus dados enquanto sua conta estiver ativa. O registro das doações pode ser mantido pelo prazo exigido em lei, para fins de prestação de contas."),
        ("Como protegemos seus dados", "A senha é armazenada de forma protegida, com hash criptográfico. CPF e e-mail nunca aparecem no site. Nas campanhas, mostramos apenas o primeiro nome e a inicial do sobrenome de quem doou."),
        ("Seus direitos", "Nos termos da Lei Geral de Proteção de Dados Pessoais (LGPD, Lei nº 13.709/2018), você pode solicitar acesso, correção ou exclusão dos seus dados a qualquer momento pelo e-mail contato@esperancasolidaria.demo.")
    ];
}
