@page "/"
@implements IAsyncDisposable
@inject Api Api
@inject Sessao Sessao

<PageTitle>Conexão Solidária · Painel de transparência</PageTitle>

<section class="hero com-foto">
    <div class="wrap hero-in">
        <div class="hero-text">
            <span class="eyebrow">Painel de transparência</span>
            <h1>Cada real doado,<br /> <em>à vista de <span class="nw">todos.<span class="h1-sol"><Sol Expressao="acenando" Tamanho="80" Acenando="true" SemSombra="true" /></span></span></em></h1>
            <p>Acompanhe quanto cada campanha da ONG Esperança Solidária já arrecadou. O valor muda assim que uma doação é confirmada.</p>
            <div class="hero-cta">
                <a class="btn btn-doar btn-lg" href="@LinkQueroDoar"><Icone Nome="heart" />Quero doar</a>
                <a class="btn btn-ghost btn-lg" href="como-funciona">Como funciona</a>
            </div>
        </div>
        @if (_ativas is { Count: 0 })
        {
            @* Site recém-publicado: em vez de "R$ 0 de R$ 0", um convite. *@
            <div class="card hero-fig hero-boasvindas">
                <Sol Expressao="acenando" Tamanho="96" Acenando="true" />
                <h2>As primeiras campanhas estão chegando</h2>
                <p class="muted">Assim que a ONG publicar uma campanha, você acompanha aqui quanto cada uma arrecadou, em tempo real.</p>
                <a class="btn btn-ghost" href="como-funciona">Conheça a ONG</a>
            </div>
        }
        else
        {
        <div class="card hero-fig">
            <div class="lbl-top"><span class="muted small">Arrecadado nas campanhas ativas</span></div>
            <div class="big tnum"><Contador Valor="Total" Moeda="true" Texto="@Formatos.DinheiroInteiro(Total)" Teste="total-arrecadado" /></div>
            <div class="sub">de @Formatos.DinheiroInteiro(SomaMetas) somando as metas · @Formatos.Porcentagem(Formatos.Progresso(Total, SomaMetas))</div>
            <div style="margin-top:8px">
                <span class="live"><i></i><span>@(_atualizadoEm is null ? "Carregando…" : $"Atualizado {Formatos.Ha(_atualizadoEm.Value)}")</span></span>
            </div>
            <div style="margin-top:14px"><Medidor Progresso="@Formatos.Progresso(Total, SomaMetas)" Classe="lg" /></div>
            <div class="hero-stats">
                <div><strong>@(_ativas?.Count ?? 0)</strong><span>campanhas ativas</span></div>
                <div><strong class="tnum">@Formatos.Numero(_ativas?.Sum(c => c.CriancasAtendidas ?? 0) ?? 0)</strong><span>crianças atendidas</span></div>
                <div><strong class="tnum">@Formatos.Numero(_ativas?.Count(c => !c.PrazoEncerrado) ?? 0)</strong><span>recebendo doações</span></div>
            </div>
        </div>
        }
    </div>
</section>

@if (_ativas is not { Count: 0 })
{
<section class="wrap section">
    <div class="section-head">
        <h2>Campanhas ativas</h2>
        <span class="muted small">@(_ativas?.Count ?? 0) @((_ativas?.Count ?? 0) == 1 ? "campanha" : "campanhas") · abertas primeiro</span>
    </div>
    @if (_erro is not null)
    {
        <Estado Expressao="preocupado" Titulo="Não conseguimos carregar as campanhas" Texto="@_erro">
            <button class="btn btn-primary" @onclick="CarregarAsync">Tentar de novo</button>
        </Estado>
    }
    else if (_ativas is null)
    {
        <Carregando Texto="Buscando as campanhas" />
    }
    else if (_ativas.Count == 0)
    {
        <Estado Expressao="espiando" Titulo="Nenhuma campanha ativa no momento" Texto="Volte em breve: novas campanhas aparecem aqui assim que são publicadas pela ONG." Tamanho="120" />
    }
    else
    {
        var categorias = _ativas.Where(c => c.Categoria is not null).Select(c => c.Categoria!).Distinct().Order().ToList();
        var filtradas = _ativas.Where(c => _categoria == "" || c.Categoria == _categoria).ToList();
        @if (categorias.Count > 1)
        {
            <div class="chips painel-filtro" role="group" aria-label="Filtrar campanhas por categoria">
                <button class="chip @(_categoria == "" ? "on" : "")" aria-pressed="@(_categoria == "" ? "true" : "false")" @onclick="() => Filtrar(string.Empty)">Todas <span>@Formatos.Numero(_ativas.Count)</span></button>
                @foreach (var cat in categorias)
                {
                    <button class="chip @(_categoria == cat ? "on" : "")" aria-pressed="@(_categoria == cat ? "true" : "false")" @onclick="() => Filtrar(cat)">@cat <span>@Formatos.Numero(_ativas.Count(c => c.Categoria == cat))</span></button>
                }
            </div>
        }
        <div class="grid-cards">
            @foreach (var c in filtradas.Take(_visiveis))
            {
                <CardCampanha @key="c.Id" Id="c.Id" Titulo="@c.Titulo" Descricao="@c.Descricao" Meta="c.MetaFinanceira"
                              Arrecadado="c.ValorTotalArrecadado" DataFim="c.DataFim" PrazoEncerrado="c.PrazoEncerrado"
                              Categoria="@c.Categoria" CapaId="@c.Capa" />
            }
        </div>
        @if (filtradas.Count > _visiveis)
        {
            <div class="mais-campanhas">
                <button class="btn btn-ghost" @onclick="() => _visiveis += PorVez">Mostrar mais campanhas <span class="muted">(@Formatos.Numero(filtradas.Count - _visiveis) restantes)</span></button>
            </div>
        }
    }
</section>
}

@code {
    // Com muitas campanhas, o painel mostra 12 por vez (mais leve no celular e na atualização a cada 5 s).
    private const int PorVez = 12;
    private int _visiveis = PorVez;
    private string _categoria = "";
    private List<CampanhaAtiva>? _ativas;
    private string? _erro;
    private DateTime? _atualizadoEm;
    private readonly CancellationTokenSource _cts = new();

    private void Filtrar(string categoria)
    {
        _categoria = categoria;
        _visiveis = PorVez;
    }

    private decimal Total => _ativas?.Sum(c => c.ValorTotalArrecadado) ?? 0;
    private decimal SomaMetas => _ativas?.Sum(c => c.MetaFinanceira) ?? 0;

    private string LinkQueroDoar => Sessao.EhDoador && _ativas?.FirstOrDefault(c => !c.PrazoEncerrado) is { } primeira ? $"campanhas/{primeira.Id}"
        : Sessao.EhGestor ? "gestao" : "cadastro";

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
        _ = AtualizarSozinhoAsync();
    }

    private async Task CarregarAsync()
    {
        var r = await Api.CampanhasAtivasAsync();
        if (r.Ok)
        {
            // Abertas primeiro (pelo prazo); as de prazo encerrado vão para o fim da lista.
            _ativas = r.Valor!.OrderBy(c => c.PrazoEncerrado).ThenBy(c => c.DataFim).ToList();
            _erro = null;
            _atualizadoEm = DateTime.UtcNow;
        }
        else if (_ativas is null)
            _erro = r.Problema!.Mensagem;
    }

    // Tempo real do painel: busca de novo a cada 5 s (o valor sobe quando o worker processa uma doação).
    private async Task AtualizarSozinhoAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token))
            {
                await CarregarAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        return ValueTask.CompletedTask;
    }
}
